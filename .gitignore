# Python
.venv/
__pycache__/
*.pyc

# Node / frontend
frontend/node_modules/
frontend/dist/

# Runtime data — regenerated on each run, never commit real capture data
network_traffic.db
*.db

# OS / editor
.DS_Store
.vscode/

# ML artifacts — ignore the dir by default, but keep the trained runtime files tracked
# so a fresh clone can run detection without retraining. The large
# cleaned_data.parquet stays ignored (regenerable via ml/data_cleaning/clean_data.py).
ml/artifacts/*
!ml/artifacts/model.joblib
!ml/artifacts/scaler.joblib
!ml/artifacts/feature_spec.json
!ml/artifacts/metrics.json
data/captured/
data/*.csv
data_cleaning/datasets/*.csv
